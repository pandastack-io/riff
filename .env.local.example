# ─── PandaStack (required) ──────────────────────────────────────────────────
# The compute layer. Every generated app runs in a PandaStack Firecracker microVM.
# Get a key at https://app.pandastack.ai — or point these at your OWN self-hosted
# PandaStack cluster to run the whole thing on your own hardware.
PANDASTACK_API_KEY=pds_xxx
PANDASTACK_API_URL=https://api.pandastack.ai
PANDASTACK_PREVIEW_SUFFIX=pandastack.ai

# ─── Codegen model (pick one; OpenAI wins if both set) ──────────────────────
# With neither set, a deterministic template generator runs so the pipeline still
# works end-to-end — but set one of these for real AI generation.
OPENAI_API_KEY=sk-proj-xxx
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Understanding the ask (the Brief + acceptance checking) ────────────────
# Riff writes a Brief — what it understood — before it builds, using a FAST model,
# then checks the running app against that Brief's acceptance list. Both reuse the
# keys above; these only override the defaults.
# RIFF_FAST_MODEL=gpt-4o-mini          # or claude-haiku-4-5-20251001 on Anthropic
#
# Acceptance checking drives the system Chrome headlessly over the preview URL.
# It is auto-detected; set CHROME_PATH if it lives somewhere unusual.
# CHROME_PATH=/usr/bin/google-chrome
# RIFF_VERIFY=0                        # turn the acceptance check off entirely
# RIFF_VERIFY_NO_SANDBOX=1             # only if the orchestrator runs as root in a container
# RIFF_VERIFY_INSECURE=1               # only for a self-hosted cluster with a self-signed cert

# ─── In-app image generation (optional, uses OPENAI_API_KEY) ────────────────
# The model can reference /riff-gen/<description>.png and Riff fills them with real
# generated images (gpt-image-1). Set RIFF_IMAGEGEN=0 to disable.
OPENAI_IMAGE_MODEL=gpt-image-1
# RIFF_IMAGEGEN=0

# ─── GitHub export (optional) ───────────────────────────────────────────────
# A Personal Access Token with 'repo' scope enables one-click "Export to GitHub".
# GITHUB_TOKEN=ghp_xxx
